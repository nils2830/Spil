{
  "manifest_version": 3,
  "name": "Reels mens Claude tænker",
  "version": "1.0.0",
  "description": "Åbner Instagram Reels, når Claude går i gang, og lukker fanen og hopper tilbage til Claude, så snart svaret er færdigt.",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["net-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["detect.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Reels mens Claude tænker",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
